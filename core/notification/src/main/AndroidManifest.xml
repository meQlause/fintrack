<?xml version="1.0" encoding="utf-8"?>
<!-- FR-081, FR-080: the listener service; no INTERNET permission anywhere in the app (NFR-001) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.bca.mybca.omni.android" />
        <package android:name="com.bca" />
        <package android:name="id.bmri.livin" />
        <package android:name="id.co.bri.brimo" />
        <package android:name="com.gojek.gopay" />
        <package android:name="com.gojek.app" />
        <package android:name="ovo.id" />
        <package android:name="id.dana" />
        <package android:name="com.shopee.id" />
    </queries>

    <application>
        <service
            android:name="com.meqlause.fintrack.core.notification.FintrackNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- FR-089: handles the Konfirmasi and Abaikan actions of the heads-up prompt; app-private -->
        <receiver
            android:name="com.meqlause.fintrack.core.notification.InboxActionReceiver"
            android:exported="false" />
    </application>
</manifest>
